generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================= ENUMS =================
enum Role {
  ADMINISTRADOR
  ASISTENTE      // Cajeros / Secretarias
  REVISADOR      // Los que suben notas
  LIBRE
  DELEGADO
  REPRESENTANTE_IE
}

enum Nivel {
  INICIAL
  PRIMARIA
  SECUNDARIA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum MetodoPago {
  YAPE
  PLIN
  TRANSFERENCIA
  EFECTIVO
}

enum EstadoRegistro {
  INCOMPLETO // Inscrito en caja, falta llenar DNI y Nombres
  COMPLETO   // Datos completos
}

enum TipoComprobante {
  TICKET_INTERNO
  BOLETA
  FACTURA
}
enum TipoColegio {
  ESTATAL
  PARTICULAR
  LIBRE
}
// ================= MODELOS =================

model User {
  id                   String       @id @default(cuid())
  name                 String?
  email                String?      @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 Role         @default(LIBRE)
  dni                  String?      @unique
  celular              String?
  institucion          String?
  localidad            String?
  
  // NUEVO: Usamos el Enum para el tipo de colegio
  tipoColegio          TipoColegio  @default(ESTATAL)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relaciones
  estudiantesInscritos Estudiante[] @relation("InscritosPor")
  
  pagosComoCliente     Pago[]       @relation("PagosCliente")
  pagosCobrados        Pago[]       @relation("PagosCobrados")

  accounts             Account[]
  sessions             Session[]
}

model Pago {
  id              String          @id @default(cuid())
  tipoComprobante TipoComprobante @default(TICKET_INTERNO)
  serie           String          @default("T001")
  correlativo     Int             @default(autoincrement())
  
  montoTotal      Float
  descuento       Float           @default(0)
  cuponId         String?         @unique
  cupon           Cupon?          @relation(fields: [cuponId], references: [id])
  
  // NUEVA RELACIÓN: Un ticket puede tener múltiples pagos parciales
  detalles        DetallePago[]   
  
  estado          EstadoPago      @default(APROBADO)
  
  clienteId       String
  cliente         User            @relation("PagosCliente", fields: [clienteId], references: [id])
  cajeroId        String?
  cajero          User?           @relation("PagosCobrados", fields: [cajeroId], references: [id])
  
  estudiantes     Estudiante[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([serie, correlativo])
}
model DetallePago {
  id              String     @id @default(cuid())
  pagoId          String
  pago            Pago       @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  
  metodo          MetodoPago
  monto           Float
  numeroOperacion String?
  comprobanteUrl  String?
  
  fechaHoraPago   DateTime?  @default(now())
  
  createdAt       DateTime   @default(now())
}
model Estudiante {
  id               String         @id @default(cuid())
  dni              String?        @unique
  nombres          String?
  apellidos        String?
  nivel            Nivel
  gradoOEdad       String
  institucion      String
  localidad        String
  impresiones Int @default(0)
  estadoRegistro   EstadoRegistro @default(COMPLETO)

  // Usuario que lo inscribió
  creadorId        String
  creador          User           @relation("InscritosPor", fields: [creadorId], references: [id])

  // Pago asociado
  pagoId           String?
  pago             Pago?          @relation(fields: [pagoId], references: [id])

  resultado        ResultadoExamen?
  tipoColegio      TipoColegio  @default(ESTATAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ResultadoExamen {
  id               String     @id @default(cuid())
  estudianteId     String     @unique
  estudiante       Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  
  correctas        Int        @default(0)
  incorrectas      Int        @default(0)
  enBlanco         Int        @default(0)
  puntajeTotal     Float      @default(0)
  horaSalida       DateTime?

  respuestasDetalle Json?

  revisadorId      String?
  
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}
model ConfiguracionConcurso {
  id                 String   @id @default(cuid())
  nivel              String
  gradoOEdad         String
  
  turno              String   @default("Turno 1")
  horaInicio         String
  horaFin            String

  costoEstatalReg    Float    @default(10)
  costoEstatalExt    Float    @default(15)
  costoParticularReg Float    @default(12)
  costoParticularExt Float    @default(17)
  costoLibreReg      Float    @default(15)
  costoLibreExt      Float    @default(20)

  cantidadPreguntas  Int
  puntosCorrecto     Float
  puntosIncorrecto   Float
  puntosBlanco       Float

  clavesRespuestas   Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([nivel, gradoOEdad, turno], name: "nivel_grado_turno")
}

// ================= NEXTAUTH =================
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
// ================= CUPONES DE DESCUENTO =================
model Cupon {
  id          String   @id @default(cuid())
  codigo      String   @unique // Aquí irá el código de 6 dígitos (Ej: "OLNA50")
  monto       Float    // El valor del descuento (20, 50, 100 soles)
  usado       Boolean  @default(false)
  
  // Relación inversa con Pago (1 a 1)
  pago        Pago?    // Se vincula automáticamente cuando un delegado lo canjea

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model DescuentoColegio {
  id          String   @id @default(cuid())
  institucion String   @unique
  descuento   Float    // Ej: 2 (S/ 2.00 por inscrito)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}